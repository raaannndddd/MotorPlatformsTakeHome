# Copy to .env (loaded by Spring at startup). Never commit real values.
SERVER_PORT=8080
# Used to build the link sent by SMS.
PUBLIC_BASE_URL=http://localhost:8080

DATABASE_URL=jdbc:postgresql://localhost:55432/motor
DATABASE_USERNAME=motor
DATABASE_PASSWORD=motor

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (must decode to exactly 32 bytes)
PII_ENCRYPTION_KEY=
# openssl rand -base64 32  (signs the local storage mock's upload/download URLs)
STORAGE_SIGNING_SECRET=

# Browsers treat http://localhost as a secure context, so Secure cookies work in dev.
COOKIE_SECURE=true

# ./gradlew seedAdmin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
